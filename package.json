{
  "name": "desktop-pet",
  "version": "0.1.0",
  "description": "Hybrid AI desktop pet (Ollama + Gemini)",
  "main": "./out/main/index.js",
  "author": "pet",
  "scripts": {
    "dev": "chcp 65001 >nul && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "icon:render": "electron scripts/render-icon.cjs",
    "prepare:model-license": "node scripts/prepare-model-license.cjs",
    "dist:prepare": "npm run prepare:model-license && npm run icon:render && electron-vite build",
    "dist:package": "electron-builder --win",
    "dist": "npm run dist:prepare && npm run dist:package -- --config.directories.output=release"
  },
  "dependencies": {
    "@edyrkaj/openwakeword-wasm-browser": "^1.0.1",
    "@google/genai": "^1.0.0",
    "node-edge-tts": "^1.2.10",
    "tesseract.js": "^7.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
